{
  "functions": {
    "source": "firebase_functions"
  },
  "firestore": {
    "rules": "src/config/firebase/firestore.rules",
    "indexes": "src/config/firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "src/config/firebase/storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
